# Configure these in the backend host's environment settings.
# Never place a real API key in this file or commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
FRONTEND_ORIGINS=https://flood-lens-ai-gamma.vercel.app
# Point this to a persistent disk path on the backend host.
FLOODLENS_DB_PATH=/var/data/floodlens_reports.sqlite3
